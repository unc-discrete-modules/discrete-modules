# Local PostgreSQL service credentials
POSTGRES_USER=discrete_modules
POSTGRES_PASSWORD=change-me
POSTGRES_DB=discrete_modules
POSTGRES_PORT=5432

# Used by the FastAPI application. Docker Compose builds this value from the
# Postgres credentials above; use this value when running the backend directly.
DATABASE_URL=postgresql+psycopg://discrete_modules:change-me@localhost:5432/discrete_modules
ALLOWED_ORIGINS=["http://localhost:5173"]

