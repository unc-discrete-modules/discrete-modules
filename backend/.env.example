# Copy to .env and configure for your local environment.
# Replace this placeholder with your PostgreSQL connection URL.
DATABASE_URL=postgresql+psycopg://localhost/discrete_modules

# JSON array of allowed frontend origins.
ALLOWED_ORIGINS=["http://localhost:5173"]

# JSON array of full UNC email addresses allowed administrator access.
ADMIN_EMAILS=[]

# Directory read by `python -m src.seed`; defaults to the repository's content/.
# CONTENT_DIR=../content

# Local HTTP development only. Production requires HTTPS and secure cookies.
ENVIRONMENT=development
# Development mode enables POST /api/auth/dev-login for demo@example.test.
PUBLIC_ORIGIN=http://localhost:5173
AUTH_COOKIE_SECURE=false

# SAML files must be readable by the backend. Never commit the private key.
SAML_IDP_METADATA_PATH=saml/unc-idp.xml
# SAML_SP_CERTIFICATE_PATH=../keys/saml-certs/sp.crt
# SAML_SP_PRIVATE_KEY_PATH=../keys/saml-certs/sp.key

# Configure only after confirming UNC's released email location.
# SAML_EMAIL_SOURCE=nameid
# Or use attribute with the exact Attribute Name (not FriendlyName):
# SAML_EMAIL_SOURCE=attribute
# SAML_EMAIL_ATTRIBUTE=urn:oid:0.9.2342.19200300.100.1.3
